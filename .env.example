# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/al-madina
# For Docker: mongodb://mongo:27017/al-madina

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Docker: redis://redis:6379

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloud_name

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Al Madina <noreply@almadina.com>"
ADMIN_EMAIL=concierge@almadina.com

# ─── Client ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Payments ──────────────────────────────────────────────────────────────────
# HMAC secret verifying X-Webhook-Signature on POST /payments/callback (the
# simulated gateway's callback). Swap for the real gateway's webhook secret
# once one is chosen — see src/modules/payments/providers/index.ts.
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
